# ==================================================
# NormWise Application Environment Configuration Template
# Do NOT place actual production secrets in this file.
# Copy to .env and configure appropriate values for your environment.
# ==================================================

# 1. Environment & Server Networking
NODE_ENV=development
PORT=5001
CLIENT_URL=http://localhost:5173
APP_VERSION=1.0.0-mvp

# 2. Database Connection (PostgreSQL + pgvector)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL=postgresql://normwise:normwise_password@localhost:5432/normwise?schema=public

# 3. Authentication & Session Security (Phase 18)
# Must be a high-entropy string at least 32 characters long in production
AUTH_SECRET=replace-with-a-secure-random-32-character-secret-in-production
AUTH_COOKIE_NAME=normwise_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
ACCESS_TOKEN_EXPIRY=1h
SESSION_EXPIRY_DAYS=7

# 4. Storage & File Management (Phase 19)
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25
DOCUMENT_PROCESSING_TIMEOUT=60000
REQUEST_BODY_LIMIT=10mb

# 5. External AI Providers & Graceful Degradation
# In development/offline mode, defaults fall back to local rule-based heuristics
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=

LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

TRANSLATION_PROVIDER=local
TRANSLATION_MODEL=bhashini
TRANSLATION_API_KEY=

OCR_ENABLED=true

# 6. Retrieval & Algorithm Parameters
VECTOR_CANDIDATE_LIMIT=20
LEXICAL_CANDIDATE_LIMIT=30

# 7. Logging & Telemetry
LOG_LEVEL=info

# 8. Rate Limiting Limits
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_API_MAX=120
RATE_LIMIT_WINDOW_MS=900000

{
  "name": "normwise",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"FRONTEND,BACKEND\" -c \"cyan.bold,green.bold\" \"npm run client\" \"npm run server\"",
    "client": "npm run dev --prefix frontend",
    "server": "npm run dev --prefix backend",
    "build": "npm run build --prefix frontend",
    "lint": "npm run lint --prefix frontend",
    "test": "npm test --prefix backend",
    "test:e2e": "node --test tests/e2e/**/*.test.js"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}

# Multi-stage production build for NormWise React Frontend (Phase 19)

# Stage 1: Build the React + Vite application
FROM node:20-alpine AS build

WORKDIR /app

# Install dependencies with clean cache
COPY package.json package-lock.json ./
RUN npm ci

# Copy application sources
COPY index.html vite.config.js ./
COPY public/ ./public/
COPY src/ ./src/

# Set production API base URL default for Docker deployment
ARG VITE_API_BASE_URL=/api
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}

# Build optimized production bundle
RUN npm run build

# Stage 2: Serve using lightweight, hardened Nginx Alpine
FROM nginx:1.27-alpine AS runner

# Remove default nginx HTML
RUN rm -rf /usr/share/nginx/html/*

# Copy built frontend assets
COPY --from=build /app/dist /usr/share/nginx/html

# Copy custom Nginx configuration with SPA fallback and health check
COPY docker/nginx/frontend.conf /etc/nginx/conf.d/default.conf

# Expose HTTP port
EXPOSE 80

# Health check to ensure frontend web server is responsive
HEALTHCHECK --interval=15s --timeout=5s --start-period=5s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider http://127.0.0.1/health || exit 1

CMD ["nginx", "-g", "daemon off;"]

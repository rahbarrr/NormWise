# ==============================================================================
# NormWise Backend Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. REQUIRED CONFIGURATION (System will not start without these)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=5001
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
# Optional legacy Prisma utilities; the API does not require this to start.
DATABASE_URL=

# Security & Authentication Secrets
AUTH_SECRET=replace-with-a-secure-random-32-character-secret-in-production
AUTH_COOKIE_NAME=normwise_session
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
ACCESS_TOKEN_EXPIRY=1h
SESSION_EXPIRY_DAYS=7

# File Storage Configuration
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25
DOCUMENT_PROCESSING_TIMEOUT=60000
REQUEST_BODY_LIMIT=10mb

# ------------------------------------------------------------------------------
# 2. OPTIONAL INTEGRATIONS & AI PROVIDERS (Deterministic fallback if omitted)
# ------------------------------------------------------------------------------
# Vector Embedding Configuration (local heuristic fallback available)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_API_KEY=

# LLM Recommendation Explanation Provider (deterministic fallback available)
LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# Translation / Multilingual Normalization (local dictionary fallback available)
TRANSLATION_PROVIDER=local
TRANSLATION_MODEL=bhashini
TRANSLATION_API_KEY=

# OCR Optical Character Recognition for Scanned Documents
OCR_ENABLED=true

# ------------------------------------------------------------------------------
# 3. DEMO & TUNING PARAMETERS (Safe defaults for SIH demonstration)
# ------------------------------------------------------------------------------
APP_VERSION=1.0.0-sih-demo
VECTOR_CANDIDATE_LIMIT=20
LEXICAL_CANDIDATE_LIMIT=30
LOG_LEVEL=info

# Rate Limiting Controls
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_API_MAX=120
RATE_LIMIT_WINDOW_MS=900000
